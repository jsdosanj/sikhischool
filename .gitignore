# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext
.open-next/
.wrangler/
.dev.vars

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code local session state (checkpoints, agent worktrees) — never
# committed; a stray agent worktree here (with its own worker-configuration.d.ts)
# was polluting `npm run lint` results (2026-09-04, false-positive 586 errors).
.claude/
