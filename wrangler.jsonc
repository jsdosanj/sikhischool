{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sikhischool",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0d4412e40181808b16cce0225ddb5152",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sikhischool",
      "database_id": "1ccc6190-dab9-45f0-a31e-ff88a9b43de0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sikhischool-media"
    }
  ]
}
